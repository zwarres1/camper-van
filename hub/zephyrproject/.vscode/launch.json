{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Zephyr J-Link Debug",
            "type": "cortex-debug",
            "request": "launch",
            "servertype": "jlink",
            "cwd": "${workspaceFolder}",
            // Path to the Zephyr compiled ELF file
            "executable": "${workspaceFolder}/build/zephyr/zephyr.elf",
            // Change this to match your exact microcontroller target (e.g., "nRF52840_xxAA", "STM32F407VG")
            "device": "PIC32CX1025SG41128", 
            "interface": "swd",
            "runToEntryPoint": "main",
            
            // Toolchain configuration (Update path/prefix depending on your host OS and SDK version)
            "armToolchainPath": "${env:HOME}/zephyr-sdk-1.0.1/gnu/arm-zephyr-eabi/bin",
            "toolchainPrefix": "arm-zephyr-eabi",
            
            // This enables Zephyr Thread Awareness in VS Code!
            "serverArgs": [
                "-rtos", "GDBServer/RTOSPlugin_Zephyr"
            ],
            
            "svdFile": "${workspaceFolder}/PIC32CX1025SG41128.svd",

            // Optional: Runs a VS Code task to build the project automatically before debugging
            "preLaunchTask": "west build" 
        }
    ]
}