{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "west build",
            "type": "shell",
            // Source the venv, then run west build targeting your board
            "command": "source .venv/bin/activate && west build -b pic32cx_sg41_cult",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            // This tells VS Code not to wait for a background task to finish
            "isBackground": false,
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}